<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <!-- 날짜 -->
    <TextView
        android:id="@+id/saved_date"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="25\nJan"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 구분선 -->
    <View
        android:id="@+id/line_vertical"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#DDDDDD"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/saved_date"
        app:layout_constraintStart_toStartOf="@id/saved_date"
        app:layout_constraintTop_toBottomOf="@id/saved_date" />

    <!-- 중첩 리사이클링뷰 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/saved_cards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/saved_date"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/activity_saved_quiz" /> </androidx.constraintlayout.widget.ConstraintLayout>