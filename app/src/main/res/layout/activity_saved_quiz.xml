<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <!-- 콘텐츠 이미지 -->
    <ImageView
        android:id="@+id/content_img"
        android:layout_width="157dp"
        android:layout_height="169dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <!-- 저장한 콘텐츠 제목 -->
    <TextView
        android:id="@+id/content_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="퀴즈 제목"
        android:textAlignment="center"
        android:textColor="@color/button_text_default"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/content_img"
        app:layout_constraintStart_toStartOf="@+id/content_img"
        app:layout_constraintTop_toBottomOf="@+id/content_img" />

    <!-- 저장한 콘텐츠 문제 -->
    <TextView
        android:id="@+id/content_ref"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:text="퀴즈 설명"
        android:textAlignment="center"
        android:textColor="@color/button_text_default"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/content_img"
        app:layout_constraintStart_toStartOf="@+id/content_img"
        app:layout_constraintTop_toBottomOf="@+id/content_title" />

</androidx.constraintlayout.widget.ConstraintLayout>