<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= 상단 AppBar ================= -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/white"
            android:paddingVertical="8dp"
            app:title="Quiz"
            app:titleTextColor="@android:color/black"
            app:menu="@menu/menu_main"
            app:titleTextAppearance="@style/ToolbarTitleBold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="70dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="확인"
        android:textColor="@color/spell_defalut_text"
        android:textSize="16sp"
        android:textStyle="bold"

        app:backgroundTint="@color/button_default_bg"
        app:cornerRadius="60dp"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/button_text_default"
        app:strokeWidth="1dp" />




    <!-- ================= 콘텐츠 영역 ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toTopOf="@id/btnConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Q 번호 -->
        <TextView
            android:id="@+id/QText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Q1" />

        <!-- 질문 -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="24dp"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/QText"
            app:layout_constraintTop_toTopOf="@id/QText"
            tools:text="신조어 '저메추'의 뜻은?" />

        <!-- 선택지 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoice1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"

            android:textColor="@color/button_text_default"
            android:textSize="14sp"
            android:textStyle="bold"

            app:backgroundTint="@color/button_default_bg"
            app:cornerRadius="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/QText"
            app:strokeColor="@color/button_default_stroke"
            app:strokeWidth="1dp"
            tools:text="저녁 메뉴 추천" />

        <!-- 선택지 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoice2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"

            android:textColor="@color/button_text_default"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/button_default_bg"

            app:cornerRadius="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChoice1"
            app:strokeColor="@color/button_default_stroke"
            app:strokeWidth="1dp"
            tools:text="점심 메뉴 추천" />

        <!-- 선택지 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoice3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"

            android:textColor="@color/button_text_default"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/button_default_bg"

            app:cornerRadius="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChoice2"
            app:strokeColor="@color/button_default_stroke"
            app:strokeWidth="1dp"
            tools:text="저렴한 메뉴 추천" />

        <!-- 선택지 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoice4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"

            android:textColor="@color/choice_text_selected"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/choice_default"

            app:cornerRadius="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChoice3"
            app:strokeColor="@color/choice_text_selected"
            app:strokeWidth="1dp"
            tools:text="저녁 메뉴 추가" />


        <!-- 상황 예시 보기 -->
        <TextView
            android:id="@+id/btnShowExample"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="80dp"
            android:drawableStart="@drawable/btn_add_icon"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="상황 예시 보기"
            android:textColor="@color/choice_text_selected"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChoice4" />

        <!-- 상황 예시 이미지 (결과 화면과 동일 크기) -->
        <ImageView
            android:id="@+id/DogImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginStart="64dp"
            android:layout_marginTop="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnChoice4"
            app:srcCompat="@drawable/content_dog" />

        <ImageView
            android:id="@+id/imgExample"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChoice4" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
